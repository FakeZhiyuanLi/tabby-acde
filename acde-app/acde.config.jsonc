{
  "$schema": "./node_modules/@dopame/acde-api/config.schema.json",
  // Tabby on Dopame OS. The page (index.html) hosts Tabby's web build, which the build script
  // copies into public/tabby; src/main.js starts it with an acde connector.
  "type": "app",
  "id": "tabby",
  "label": "Tabby",
  "icon": "term",
  "entry": "index.html",
  // terminal: local shells (acde:terminal). fs: Tabby's config in the app's private folder.
  // open: only Tabby itself, so a page (or a test) can send Tabby a run request.
  "capabilities": {
    "terminal": true,
    "fs": true,
    "open": ["tabby"]
  },
  "optional": [],
  "services": [],
  // run: another app or agent hands Tabby a command; it is typed into a new tab for the user to run.
  "requests": ["run"],
  "schemes": []
}
